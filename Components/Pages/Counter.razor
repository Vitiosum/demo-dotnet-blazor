@page "/counter"
@rendermode InteractiveServer

<PageTitle>Compteur · Blazor Server · Démo Clever Cloud</PageTitle>

<section class="cc-section">
    <div class="cc-container">
        <div class="cc-card cc-card--pad cc-card--accent counter-card cc-reveal">
            <h1 class="cc-card__label">Compteur interactif</h1>
            <div class="cc-stat counter-value @(flash ? "cc-stat--flash" : "")" aria-live="polite">@currentCount</div>
            <div class="counter-actions">
                <button type="button" class="cc-btn cc-btn--gradient" @onclick="IncrementCount">Incrémenter</button>
                <button type="button" class="cc-btn" @onclick="Reset">Réinitialiser</button>
            </div>
            <div class="cc-mt-3"><span class="cc-pill cc-pill--ok"><span class="cc-dot"></span>Rendu serveur · SignalR</span></div>
            <p class="counter-note">Chaque clic est traité côté serveur et renvoyé par SignalR — aucun JavaScript métier côté client.</p>
        </div>
    </div>
</section>

@code {
    private int currentCount;
    private bool flash;

    private async Task IncrementCount()
    {
        currentCount++;
        flash = true;
        await Task.Delay(200);
        flash = false;
    }

    private void Reset() => currentCount = 0;
}
