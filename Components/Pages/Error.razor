@page "/Error"
@using System.Diagnostics

<PageTitle>Erreur · Blazor Server · Démo Clever Cloud</PageTitle>

<section class="cc-section">
    <div class="cc-container">
        <div class="cc-card cc-card--pad cc-card--accent error-card">
            <div class="cc-card__label">Erreur</div>
            <h1 class="cc-section__title cc-mt-1">Une erreur s'est produite pendant le traitement de la requête.</h1>
            @if (ShowRequestId)
            {
                <p class="cc-card__hint">Request ID : <span class="cc-kbd">@RequestId</span></p>
            }
            <p class="cc-mt-2">Le détail n'est pas affiché en production. Pour le diagnostic, consultez les logs de l'application avec <span class="cc-kbd">clever logs</span>.</p>
            <div class="cc-mt-3"><a class="cc-btn cc-btn--gradient" href="/">Retour à l'accueil <span class="cc-btn__arrow">→</span></a></div>
        </div>
    </div>
</section>

@code{
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
