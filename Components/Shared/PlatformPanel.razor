@* Variables de démo et variables injectées par Clever Cloud, lues au démarrage (DemoSettings). *@
<ul class="lb-config" aria-label="Variables de démo lues par l'application">
    <li><span>APP_ENV</span><b>@DemoSettings.AppEnv</b></li>
    <li><span>ROOM_NAME</span><b>@DemoSettings.RoomName</b></li>
    <li><span>PULSE_MS</span><b>@DemoSettings.PulseMs</b></li>
    <li><span>ANNOUNCEMENT</span>@if (DemoSettings.Announcement.Length == 0) { <b class="is-empty">non définie</b> } else { <b>définie</b> }</li>
</ul>
<dl class="lb-vars" aria-label="Variables injectées par Clever Cloud">
    <div><dt>Instance</dt><dd class="@Cls(DemoSettings.Instance)">@(DemoSettings.Instance ?? DemoSettings.Injected)</dd></div>
    <div><dt>Type d'instance</dt><dd class="@Cls(DemoSettings.InstanceType)">@(DemoSettings.InstanceType ?? DemoSettings.Injected)</dd></div>
    <div><dt>Commit déployé</dt><dd class="@Cls(DemoSettings.Commit)">@(DemoSettings.Commit ?? DemoSettings.Injected)</dd></div>
    <div><dt>Déploiement</dt><dd class="@Cls(DemoSettings.Deployment)">@(DemoSettings.Deployment ?? DemoSettings.Injected)</dd></div>
</dl>

@code {
    static string Cls(string? v) => v is null ? "is-empty" : "";
}
