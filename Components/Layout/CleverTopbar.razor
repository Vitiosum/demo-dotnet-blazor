<header class="cc-topbar">
    <div class="cc-container cc-topbar__inner">
        <a href="https://www.clever.cloud" target="_blank" rel="noopener" aria-label="Clever Cloud">
            <CleverLogo />
        </a>
        <span class="cc-topbar__sep"></span>
        <a class="cc-topbar__demo" href=""><small>Démo</small>Salle en direct</a>
        <nav class="cc-topbar__nav" aria-label="Pages">
            <NavLink class="cc-topbar__link" href="" Match="NavLinkMatch.All" ActiveClass="is-active">Salle</NavLink>
            <NavLink class="cc-topbar__link" href="counter" ActiveClass="is-active">Compteur</NavLink>
        </nav>
        <span class="cc-topbar__spacer"></span>
        <nav class="cc-topbar__nav" aria-label="Statut">
            <span class="cc-pill cc-pill--mono cc-hide-sm">.NET 8 · Blazor Server · SignalR</span>
            @if (Live)
            {
                <span class="cc-pill cc-pill--live"><span class="cc-dot"></span>Live on Clever Cloud</span>
            }
            else
            {
                <span class="cc-pill cc-pill--muted"><span class="cc-dot cc-dot--muted"></span>Local · hors Clever Cloud</span>
            }
            <a class="cc-pill cc-pill--gradient" href="https://academy.clever.cloud/" target="_blank" rel="noopener">Se certifier ↗</a>
        </nav>
    </div>
</header>

@code {
    // APP_ID est injecté par Clever Cloud sur chaque instance : absent en local.
    static bool Live => DemoSettings.Live;
}
